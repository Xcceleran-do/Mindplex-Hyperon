# Copy this file to .env and set values as needed.
ASI_API_KEY=
# Credentials used by the bundled dependency services.
POSTGRES_PASSWORD=replace-with-a-random-database-password
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ASI_ONE_API_KEY=
# Remote metadata-extractor2PLN service. The API key is the complete
# owner-id:secret bearer token configured by that service.
METADATA_EXTRACTOR_BASE_URL=http://127.0.0.1:8080
METADATA_EXTRACTOR_API_KEY=
METADATA_EXTRACTOR_NAMESPACE=A
METADATA_EXTRACTOR_TIMEOUT_SECONDS=150
METADATA_EXTRACTOR_CHUNK_SIZE=10
METADATA_EXTRACTOR_USE_MODEL=true
METADATA_EXTRACTOR_REQUIRED_PROPERTIES=engagement,audience-expertise
METADATA_MODEL_PROVIDER=asi
METADATA_ASI_MODEL=asi1-mini
METADATA_GEMINI_MODEL=gemini-2.5-flash
# NL2PLN clients send the secret; Compose adds the mindplex owner on the server.
NL2PLN_API_KEY=replace-with-at-least-32-random-characters
NL2PLN_MODEL=gemini/gemini-2.5-flash
NL2PLN_NAMESPACE=mindplex
NL2PLN_TIMEOUT_SECONDS=60
# Set false to prevent both the UI and API from starting new ingestion jobs.
INGESTION_ENABLED=true
# Reuse the current dataset for the same Mindplex username for this many days.
# Set to 0 to disable caching. POST /api/ingest with force=true bypasses it.
INGESTION_CACHE_TTL_DAYS=3
MINDPLEX_API_DOMAIN=https://api-dev.mindplex.ai
MINDPLEX_USERNAME=
# Dedicated Mindplex account used by the backend to mint/refresh sessions.
# Prefer this over manually copying short-lived access tokens.
MINDPLEX_SERVICE_EMAIL=
MINDPLEX_SERVICE_PASSWORD=
MINDPLEX_API_TOKEN=
MINDPLEX_API_REFRESH_TOKEN=
# Stores rotated access/refresh tokens so sessions survive container restarts.
MINDPLEX_TOKEN_CACHE_PATH=/app/.mindplex-auth/tokens.json
FLASK_DEBUG=0
PETTA_DEBUG=0
MINING_DEFAULT_CONJUNCTION_COUNT=2
MINING_DEFAULT_MIN_SUPPORT=3
PETTA_CHAIN_DEPTH=3
PETTA_MINING_TIMEOUT_SECONDS=90
PETTA_MINING_MAX_OUTPUT_BYTES=8388608
PETTA_CHAIN_TIMEOUT_SECONDS=90
PETTACHAINER_BASE_URL=http://127.0.0.1:8000
# Use only the secret portion of the server's owner-id:secret allowlist entry.
PETTACHAINER_API_KEY=
PETTACHAINER_KB_PREFIX=mindplex
