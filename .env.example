# Copy this file to .env and set values as needed.
ASI_API_KEY=
MINDPLEX_API_DOMAIN=https://api-dev.mindplex.ai
MINDPLEX_USERNAME=
# Dedicated Mindplex account used by the backend to mint/refresh sessions.
# Prefer this over manually copying short-lived access tokens.
MINDPLEX_SERVICE_EMAIL=
MINDPLEX_SERVICE_PASSWORD=
MINDPLEX_API_TOKEN=
MINDPLEX_API_REFRESH_TOKEN=
# Stores rotated access/refresh tokens so sessions survive container restarts.
MINDPLEX_TOKEN_CACHE_PATH=/app/.mindplex-auth/tokens.json
FLASK_DEBUG=0
PETTA_DEBUG=0
MINING_DEFAULT_CONJUNCTION_COUNT=2
MINING_DEFAULT_MIN_SUPPORT=3
PETTA_CHAIN_DEPTH=3
PETTA_MINING_TIMEOUT_SECONDS=90
PETTA_MINING_MAX_OUTPUT_BYTES=8388608
PETTA_CHAIN_TIMEOUT_SECONDS=90
PETTACHAINER_BASE_URL=http://127.0.0.1:8000
# Use only the secret portion of the server's owner-id:secret allowlist entry.
PETTACHAINER_API_KEY=
PETTACHAINER_KB_PREFIX=mindplex
