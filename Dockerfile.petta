# Use the same base image as the upstream repo
FROM swipl:latest

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends     build-essential     python3-dev     python3-pip     git     curl     && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /opt

# Clone PeTTa repository (latest commit)
# Use a build argument to bust the cache if needed, or run docker build --no-cache
RUN git clone https://github.com/yotors/PeTTa.git

# Build PeTTa and dependencies
WORKDIR /opt/PeTTa
RUN sh build.sh

# Install Python dependencies
RUN pip3 install . --break-system-packages
RUN pip3 install hyperon regex flask flask-cors python-dotenv --break-system-packages

# Modify run.sh:
# 1. Add shebang
# 2. Use absolute paths
RUN sed -i '1s/^/#!\/bin\/bash\n/' run.sh &&     sed -i 's|\./mork_ffi|/opt/PeTTa/mork_ffi|g' run.sh &&     sed -i 's|\./src/main.pl|/opt/PeTTa/src/main.pl|g' run.sh

# Make run.sh executable and available in PATH
RUN chmod +x run.sh &&     ln -s /opt/PeTTa/run.sh /usr/local/bin/run.sh

# Set the working directory for when the container runs
WORKDIR /workspace

# Default command (can be overridden)
CMD ["bash"]
