(= (bc-loop  (Cons (task prove $k (: $prf $ccln)) Nil) $acc) (exec 3 (, (kb (: $prf $ccln))) (, (: $prf $ccln))))

(= (bc-loop (Cons (task prove $k (: $prf $ccln)) (Cons $next $tail)) $acc) (exec 4 (, (kb (: $prf $ccln)) (= (bc-loop (Cons $next $tail) (: $prf $ccln)) $res)) (, $res)))

(= (bc-loop (Cons (task prove (S $k) (: ($prfabs $prfarg) $ccln)) $rest) $acc) (exec 5 (, (= (bc-loop (Cons (task prove $k (: $prfabs (-> $prms $ccln))) (Cons (task seek $k $prfarg $prms $ccln $rest) Nil)) $acc) $res)) (, $res)))

(= (bc-loop (Cons (task seek $k $prfarg $prms $ccln $saved-rest) $rest) (: $resolved-abs (-> $prms $ccln))) (exec 6 (, (= (bc-loop (Cons (task prove $k (: $prfarg $prms)) (Cons (task assemble $k $resolved-abs $ccln $saved-rest) Nil)) Nil) $res)) (, $res)))

(= (bc-loop (Cons (task assemble $k $resolved-abs $ccln Nil) $rest) (: $resolved-arg $prms)) (: ($resolved-abs $resolved-arg) $ccln))

